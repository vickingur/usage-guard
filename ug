#!/usr/bin/env python3
"""ug — control the usage guard.

  ug status [--json]     guard state, live usage for Claude and Codex, pace lines, sessions, any hold
  ug brief               the one-line position agents receive at every prompt
  ug sessions            live Claude sessions: priority, what they borrow, last call, holds
  ug priority P [ID]     set a session's priority (low, normal, high); ID is a session-id prefix,
                         optional when one session is live
  ug on | off            enable / disable the guard
  ug threshold [W PCT]   show, or set, the threshold for window 5h or 7d
  ug pace                show pacing settings
  ug pace on | off       enable / disable pacing (the threshold hold stays)
  ug pace mode M         hold (wait until back on pace) or delay (a capped slowdown per call)
  ug pace margin W PCT   how far ahead of the pace line window 5h or 7d may run
  ug pace set KEY VALUE  any numeric pacing or priority setting (see `ug config`)
  ug pace profile        show the weekly profile the 7d pace line follows
  ug pace profile uniform | workweek | weekend   a preset
  ug pace profile days 1,1,1,1,1,.3,.3    a weight per day, Monday first
  ug pace profile hours 8-23[,H-H]        active hours get weight 1, the rest 0.1
  ug sim [...]           simulate sessions against the guard's policy (ug sim --help)
  ug install             install the Claude Code plugin from this checkout and drop the legacy hooks
  ug codex install       add the guard's hook to Codex (~/.codex/hooks.json) and trust it
  ug codex trusted       exit 0 when Codex has the hook and trusts it, 1 otherwise
  ug release             release an in-progress hold right now
  ug config              print effective settings as JSON
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True  # keep the shared layer free of __pycache__
sys.path.insert(0, str(Path(__file__).resolve().parent))
import guardlib as g  # noqa: E402

HERE = Path(__file__).resolve().parent
WINDOW_ARGS = {"5h": "threshold_5h", "7d": "threshold_7d"}
MARGIN_ARGS = {"5h": "pace_margin_5h", "7d": "pace_margin_7d"}
PACE_SET_KEYS = tuple(k for k, v in g.DEFAULTS.items()
                      if (k.startswith("pace_") or k.startswith("priority_") or k.startswith("borrow_"))
                      and isinstance(v, (int, float)) and not isinstance(v, bool))
COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def paint(text, code):
    return f"\033[{code}m{text}\033[0m" if COLOR else str(text)


def fail(message):
    print(f"ug: {message}", file=sys.stderr)
    return 1


def cmd_on():
    g.save_config({"enabled": True})
    print(f"usage guard {paint('on', '32')}")
    return 0


def cmd_off():
    g.save_config({"enabled": False})
    print(f"usage guard {paint('off', '33')}")
    return 0


def cmd_threshold(args):
    cfg = g.load_config()
    if not args:
        for window, key in WINDOW_ARGS.items():
            print(f"{window}  {cfg[key]:g}%")
        return 0
    if len(args) != 2:
        return fail("usage: ug threshold <5h|7d> <percent>")
    window, raw = args
    if window not in WINDOW_ARGS:
        return fail(f"unknown window {window!r} (expected 5h or 7d)")
    value, err = parse_pct(raw, "threshold")
    if err:
        return err
    g.save_config({WINDOW_ARGS[window]: value})
    print(f"{window} threshold set to {value:g}%")
    return 0


def cmd_release():
    now = time.time()
    state = g.read_json(g.state_path(), {})
    if not isinstance(state, dict):
        state = {}
    state["release_at"] = now
    g.atomic_write(g.state_path(), state)
    rep = g.report(g.load_config(), now)
    if rep["claude"]["hold"] or rep["codex"]["hold"]:
        print("released the active hold")
    else:
        print("no hold active; the next one will not be released by this")
    return 0


def cmd_config():
    print(json.dumps(g.load_config(), indent=2))
    return 0


def parse_pct(raw, what):
    try:
        value = float(raw)
    except ValueError:
        return None, fail(f"{what} must be a number, got {raw!r}")
    if not 0 <= value <= 100:
        return None, fail(f"{what} must be between 0 and 100, got {value:g}")
    return value, 0


def cmd_pace(args):
    cfg = g.load_config()
    if not args:
        state = paint("on", "32") if cfg["pace_enabled"] else paint("off", "33")
        print(f"pacing     {state}  mode {cfg['pace_mode']}")
        for window, key in MARGIN_ARGS.items():
            print(f"margin {window:<4}{cfg[key]:g}% ahead of the pace line")
        for key in PACE_SET_KEYS:
            print(f"{key:<30}{cfg[key]:g}")
        return 0
    verb, rest = args[0], args[1:]
    if verb in ("on", "off") and not rest:
        g.save_config({"pace_enabled": verb == "on"})
        print(f"pacing {paint(verb, '32' if verb == 'on' else '33')}")
        return 0
    if verb == "mode":
        if len(rest) != 1 or rest[0] not in g.PACE_MODES:
            return fail("usage: ug pace mode <delay|hold>")
        g.save_config({"pace_mode": rest[0]})
        print(f"pace mode set to {rest[0]}")
        return 0
    if verb == "margin":
        if len(rest) != 2 or rest[0] not in MARGIN_ARGS:
            return fail("usage: ug pace margin <5h|7d> <percent>")
        value, err = parse_pct(rest[1], "margin")
        if err:
            return err
        g.save_config({MARGIN_ARGS[rest[0]]: value})
        print(f"{rest[0]} pace margin set to {value:g}%")
        return 0
    if verb == "profile":
        return cmd_profile(rest)
    if verb == "set":
        if len(rest) != 2 or rest[0] not in PACE_SET_KEYS:
            return fail("usage: ug pace set <" + "|".join(PACE_SET_KEYS) + "> <value>")
        try:
            value = float(rest[1])
        except ValueError:
            return fail(f"value must be a number, got {rest[1]!r}")
        if value < 0:
            return fail("value must not be negative")
        g.save_config({rest[0]: value})
        print(f"{rest[0]} set to {value:g}")
        return 0
    return fail("usage: ug pace [on|off|mode M|margin W PCT|set KEY VALUE]")


PROFILE_PRESETS = {
    "uniform": ([1.0] * 7, [1.0] * 24),
    "workweek": ([1.0] * 5 + [0.3, 0.3], [0.1] * 8 + [1.0] * 15 + [0.1]),
    "weekend": ([0.3, 0.3, 0.3, 0.3, 0.5, 1.0, 1.0], [0.1] * 8 + [1.0] * 15 + [0.1]),
}
DAY_NAMES = ("mon", "tue", "wed", "thu", "fri", "sat", "sun")


def parse_hours(spec: str):
    """`8-23,0-1` -> 24 weights: 1 inside the ranges (end exclusive), 0.1 outside."""
    weights = [0.1] * 24
    for part in spec.split(","):
        a, _, b = part.partition("-")
        try:
            start, end = int(a), int(b or a)
        except ValueError:
            return None
        if not (0 <= start < 24 and 0 < end <= 24 and start < end):
            return None
        for h in range(start, end):
            weights[h] = 1.0
    return weights


def cmd_profile(args):
    cfg = g.load_config()
    if not args:
        days, hours = cfg["pace_profile_days"], cfg["pace_profile_hours"]
        bars = "▁▂▃▄▅▆▇█"
        top = max(max(days), max(hours), 1e-9)
        print("days   " + " ".join(f"{DAY_NAMES[i]} {bars[min(7, int(8 * w / top - 1e-9))] if w > 0 else '·'}" for i, w in enumerate(days)))
        print("hours  " + "".join(bars[min(7, int(8 * w / top - 1e-9))] if w > 0 else "·" for w in hours) + "  (0h to 23h)")
        preset = next((name for name, (d, h) in PROFILE_PRESETS.items() if list(d) == list(days) and list(h) == list(hours)), None)
        print(f"preset {preset}" if preset else "custom")
        return 0
    if args[0] in PROFILE_PRESETS and len(args) == 1:
        days, hours = PROFILE_PRESETS[args[0]]
        g.save_config({"pace_profile_days": days, "pace_profile_hours": hours})
        print(f"weekly profile set to {args[0]}")
        return 0
    if args[0] == "days" and len(args) == 2:
        try:
            days = [float(v) for v in args[1].split(",")]
        except ValueError:
            days = []
        if len(days) != 7 or any(v < 0 for v in days):
            return fail("usage: ug pace profile days <7 weights, Monday first>")
        g.save_config({"pace_profile_days": days})
        print("day weights set")
        return 0
    if args[0] == "hours" and len(args) == 2:
        hours = parse_hours(args[1])
        if hours is None:
            return fail("usage: ug pace profile hours <H-H[,H-H]> with hours 0 to 24")
        g.save_config({"pace_profile_hours": hours})
        print("hour weights set")
        return 0
    return fail("usage: ug pace profile [uniform|workweek|days W,W,W,W,W,W,W|hours H-H[,H-H]]")


def cmd_codex(args):
    if args == ["install"]:
        result = g.codex_install(HERE)
        print(f"hooks      {result['hooks']} guard hooks in {result['hooks_path']}")
        if result["trusted_now"]:
            print(f"trusted    {len(result['trusted_now'])} hook(s) recorded in {result['config_path']}")
        else:
            print("trusted    already recorded")
        return 0
    if args == ["trusted"]:
        ok = g.codex_trusted(HERE)
        print("codex hooks " + (paint("installed and trusted", "32") if ok else paint("missing or untrusted", "33")))
        return 0 if ok else 1
    return fail("usage: ug codex <install|trusted>")


# --- install: the Claude Code plugin, and the legacy hooks out of settings.json ---

def claude_settings_path() -> Path:
    env = os.environ.get("UG_CLAUDE_SETTINGS")
    return Path(env) if env else Path.home() / ".claude" / "settings.json"


def strip_legacy_settings(path: Path) -> list:
    """Removes the command hooks and statusline the guard used to need. Returns what went."""
    doc = g.read_json(path)
    if not isinstance(doc, dict):
        return []
    removed = []
    hooks = doc.get("hooks")
    if isinstance(hooks, dict):
        for event in ("PreToolUse", "UserPromptSubmit"):
            groups = hooks.get(event)
            if not isinstance(groups, list):
                continue
            kept = []
            for group in groups:
                handlers = group.get("hooks") if isinstance(group, dict) else None
                if isinstance(handlers, list) and any("usage-guard/" in str(h.get("command", "")) for h in handlers if isinstance(h, dict)):
                    removed.append(f"hooks.{event}")
                    continue
                kept.append(group)
            if kept:
                hooks[event] = kept
            else:
                hooks.pop(event, None)
        if not hooks:
            doc.pop("hooks", None)
    status = doc.get("statusLine")
    if isinstance(status, dict) and "usage-guard/statusline.py" in str(status.get("command", "")):
        doc.pop("statusLine")
        removed.append("statusLine")
    if removed:
        g.atomic_write(path, doc)
    return removed


def marketplace_elsewhere(listing: str, here: Path) -> bool:
    """True when `claude plugin marketplace list` names a usage-guard marketplace whose folder is not `here`."""
    lines = listing.splitlines()
    for i, line in enumerate(lines):
        if line.strip().endswith("usage-guard") and i + 1 < len(lines):
            source = lines[i + 1].strip()
            if source.startswith("Source:") and ("Folder" in source or "Directory" in source):  # macOS and Linux builds differ
                path = source.split("(", 1)[1].rstrip(")") if "(" in source else ""
                return Path(path).resolve() != here.resolve()
    return False


def cmd_install():
    claude = shutil.which("claude")
    if not claude:
        return fail("`claude` is not on PATH; install Claude Code first")
    steps = []
    # A marketplace of this name registered from another checkout would keep the
    # plugin reading from there; re-point it at this one.
    listed = subprocess.run([claude, "plugin", "marketplace", "list"], capture_output=True, text=True, timeout=60).stdout
    elsewhere = marketplace_elsewhere(listed, HERE)
    if elsewhere:
        steps.append(["plugin", "marketplace", "remove", "usage-guard"])
    steps += [["plugin", "marketplace", "add", str(HERE)], ["plugin", "install", "usage-guard@usage-guard"]]
    for args in steps:
        proc = subprocess.run([claude, *args], capture_output=True, text=True, timeout=120)
        if proc.returncode != 0 and "already" not in (proc.stdout + proc.stderr).lower():
            return fail(f"claude {' '.join(args)} failed:\n{proc.stdout}{proc.stderr}".rstrip())
        print(f"claude     {' '.join(args)}")
    removed = strip_legacy_settings(claude_settings_path())
    print("settings   " + (f"removed legacy {', '.join(removed)} from {claude_settings_path()}" if removed else "no legacy entries"))
    link = Path.home() / ".local" / "bin" / "ug"
    if not (link.is_symlink() and link.resolve() == HERE / "ug"):
        link.parent.mkdir(parents=True, exist_ok=True)
        try:
            if link.is_symlink() or link.exists():
                link.unlink()
            link.symlink_to(HERE / "ug")
            print(f"cli        linked {link} -> {HERE / 'ug'}")
        except OSError as err:
            print(f"cli        could not link {link}: {err}")
    print("plugin     usage-guard installed; new sessions load it, running ones after /reload-plugins")
    return 0


# --- sessions and priorities ----------------------------------------------------

GLYPH = {"low": "▽", "normal": "◇", "high": "△"}


def lift_phrase(row) -> str:
    """`◇ normal ⇡60%△`: the class, and what it borrows (a share of the next class, or that class whole)."""
    lift, priority = row["lift"], row["priority"]
    own = f"{GLYPH[priority]} {priority}"
    if lift < 0.05:
        return own
    above = g.PRIORITIES[min(g.PRIORITIES.index(priority) + 1, 2)]
    whole, partial = int(lift + 1e-9), lift - int(lift + 1e-9)
    if whole >= 1 and partial < 0.05:
        return f"{own} ⇡{GLYPH['high' if whole == 2 else above]}"
    return f"{own} ⇡{partial * 100:.0f}%{GLYPH['high' if whole >= 1 else above]}"


def print_sessions(rows, now):
    if not rows:
        print("sessions   none live")
        return
    print(f"sessions   {len(rows)} live")
    for row in rows:
        ago = row["last_call_seconds_ago"]
        text = f"  {str(row['id'])[:8]:<8} {lift_phrase(row):<16} {g.fmt_duration(ago) if ago >= 60 else f'{ago}s'} ago"
        if row.get("delay_seconds"):
            text += paint(f"  ◔{row['delay_seconds']:.0f}s", "33")
        if row.get("hold"):
            clock = time.strftime("%H:%M", time.localtime(row["hold"]["until"]))
            text += paint(f"  {'◔' if row['hold'].get('kind') == 'pace' else '⊘'}{row['hold']['window']}→{clock}", "1;31")
        cwd = row.get("cwd") or ""
        if cwd:
            text += f"  {cwd.replace(str(Path.home()), '~', 1)}"
        print(text)


def cmd_sessions():
    now = time.time()
    print_sessions(g.report(g.load_config(), now)["claude"]["sessions"], now)
    return 0


def cmd_priority(args):
    if not args:
        return cmd_sessions()
    priority = args[0]
    if priority not in g.PRIORITIES:
        return fail("usage: ug priority <low|normal|high> [session-id-prefix]")
    now = time.time()
    rows = g.report(g.load_config(), now)["claude"]["sessions"]
    if len(args) > 2:
        return fail("usage: ug priority <low|normal|high> [session-id-prefix]")
    if len(args) == 2:
        rows = [r for r in rows if str(r["id"]).startswith(args[1])]
        if not rows:
            return fail(f"no live session starts with {args[1]!r}")
    if len(rows) != 1:
        print_sessions(rows, now)
        return fail("several sessions are live; name one by an id prefix")
    if not g.set_session_priority(rows[0]["id"], priority):
        return fail("that session's entry vanished")
    print(f"{str(rows[0]['id'])[:8]} priority set to {priority}; it applies on the session's next tool call")
    return 0


# --- status -------------------------------------------------------------------------

def cmd_brief():
    line = g.report(g.load_config())["brief"]
    print(line or "no usage data yet")
    return 0


def print_windows(windows):
    for w in windows:
        pct, line = w["used_pct"], w["pace_line_pct"]
        threshold, hold_at = w["threshold_pct"], w["hold_at_pct"]
        colour = "1;31" if pct >= hold_at else ("33" if pct >= hold_at * 0.66 else "32")
        text = f"{w['window']:<10} {paint(f'{pct:.1f}%', colour)}  hold at {hold_at:g}%  pace line {line:.0f}%"
        ahead = w["ahead_pct"]
        if ahead >= 0.5:
            text += paint(f" +{ahead:.0f}", "33")
        if w.get("pacing"):
            text += paint(f"  PACING {w['delay_seconds']:.0f}s/call, back on pace in "
                          f"{g.fmt_duration(w['catchup_in_seconds'])}", "1;33")
        if w["resets_in_seconds"] > 0:
            clock = time.strftime("%H:%M", time.localtime(w["resets_at"]))
            text += f"  resets {clock} (in {g.fmt_duration(w['resets_in_seconds'])})"
        print(text)


def cmd_status(args):
    cfg = g.load_config()
    now = time.time()
    rep = g.report(cfg, now)
    if args == ["--json"]:
        print(json.dumps(rep, indent=2))
        return 0
    if args:
        return fail("usage: ug status [--json]")
    state = paint("on", "1;32") if cfg["enabled"] else paint("off", "1;33")
    pacing = paint("on", "32") if cfg["pace_enabled"] else paint("off", "33")
    print(f"guard      {state}   pacing {pacing} ({cfg['pace_mode']})")

    claude = rep["claude"]
    print(paint("claude", "1") + "   (account terms; each session's own are under sessions)")
    if not claude["windows"]:
        print("usage      no usage data yet (no Claude session has reported a limit)")
    else:
        print_windows(claude["windows"])
        age = g.fmt_duration(claude.get("data_age_seconds", 0))
        print(f"data       {age} old" + ("  " + paint("STALE — guard fails open", "33") if claude["stale"] else ""))
    print_sessions(claude["sessions"], now)
    codex = rep["codex"]
    print(paint("codex", "1"))
    if not codex["windows"]:
        print("usage      no Codex usage yet (no hook cache, no recent session log)")
    else:
        print_windows(codex["windows"])
        where = "live hook cache" if codex.get("source") == "hook" else "newest session log"
        print(f"data       {g.fmt_duration(codex.get('data_age_seconds', 0))} old ({where})")
    for vendor, name in ((claude, "claude"), (codex, "codex")):
        hold = vendor.get("hold")
        if hold:
            clock = time.strftime("%H:%M", time.localtime(hold["until"]))
            print(paint(f"HOLD       {name}: active on {hold['window']} until {clock} "
                        f"(in {g.fmt_duration(hold['until'] - now)})", "1;31"))
            print("           run `ug release` to let the pending tool call through")
    return 0


COMMANDS = {
    "on": lambda args: cmd_on(), "off": lambda args: cmd_off(), "threshold": cmd_threshold,
    "release": lambda args: cmd_release(), "config": lambda args: cmd_config(), "status": cmd_status,
    "pace": cmd_pace, "codex": cmd_codex, "brief": lambda args: cmd_brief(), "install": lambda args: cmd_install(),
    "sessions": lambda args: cmd_sessions(), "priority": cmd_priority, "sim": lambda args: __import__("simulate").main(args),
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    command, args = argv[0], argv[1:]
    if command not in COMMANDS:
        return fail(f"unknown command {command!r}; try `ug help`")
    return COMMANDS[command](args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
